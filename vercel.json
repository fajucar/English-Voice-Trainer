{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/tutor.js": {
      "maxDuration": 30
    },
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/praticar.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self)"
        }
      ]
    }
  ]
}
